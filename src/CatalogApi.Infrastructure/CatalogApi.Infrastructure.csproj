    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CatalogApi.Application\CatalogApi.Application.csproj" />
  </ItemGroup>
